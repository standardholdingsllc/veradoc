# =============================================================================
# VeraDoc.pe — Environment Variables
# Copy to .env.local and fill in values for local development.
# =============================================================================

# --- Supabase (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Application Mode ---
# "demo" uses mock data (default), "production" uses Supabase
NEXT_PUBLIC_MODE=demo

# --- Canonical surface origins and hostname routing ---
# Use *.localhost for host-aware local development. Keep HOST_ROUTING_MODE=off
# only while comparing the legacy path behavior during rollout.
PUBLIC_ORIGIN=http://localhost:3000
APP_ORIGIN=http://app.localhost:3000
NOTARY_ORIGIN=http://notario.localhost:3000
ADMIN_ORIGIN=http://admin.localhost:3000
DEMO_ORIGIN=http://demo.localhost:3000
HOST_ROUTING_MODE=enforce

# --- Isolated shared demo backend (separate demo deployment) ---
# Connect the free Upstash Redis resource to the demo Vercel project. Vercel
# injects KV_REST_API_URL and KV_REST_API_TOKEN; do not copy them into production.
# DEMO_ISOLATED_DEPLOYMENT=true
# KV_REST_API_URL=https://your-demo-redis.upstash.io
# KV_REST_API_TOKEN=your-demo-only-redis-token
# 32+ random bytes encoded as base64url; used only to encrypt recoverable demo links.
# DEMO_TOKEN_ENCRYPTION_KEY=
# Shared only between the admin deployment and demo deployment (32+ random characters).
# DEMO_CONTROL_SECRET=
# Configure on the admin deployment so its authenticated control can reach the demo.
# DEMO_CONTROL_ORIGIN=https://demo.veradoc.pe
# Sandbox-only Resend credential and a verified sandbox sender.
# DEMO_EMAIL_API_KEY=
# DEMO_EMAIL_FROM=VeraDoc Demo <demo@your-verified-demo-domain.example>

# Require Supabase TOTP AAL2 before an admin can view or mutate admin data.
ADMIN_MFA_REQUIRED=false

# Requires supabase/migrations/20260910160000_commercial_accounting.sql.
# Keep false until that migration has an approved production rollout.
COMMERCIAL_ACCOUNTING_ENABLED=false

# --- WhatsApp Cloud API (optional — OTP delivery) ---
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Email (optional — Resend) ---
# EMAIL_API_KEY=

# --- Payments ---
# Stub payments for demo/development flow (no real charges)
DEMO_PAYMENTS_ENABLED=true

# --- Mercado Pago Checkout API (Payments API) ---
# Create an application at https://www.mercadopago.com.pe/developers/panel/app
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret
# "test" for sandbox, "production" for live payments
MERCADOPAGO_ENVIRONMENT=test

# --- IOFE Digital Signature Provider (legacy, optional) ---
# IOFE_SIGNING_API_KEY=
# IOFE_SIGNING_API_URL=

# --- FirmEasy Digital Signature (firmeasy.legal) ---
# Required for production signing flow. Leave empty for dev stub (local only).
# FIRMEASY_API_BASE_URL=https://app.firmeasy.legal/api/v1
# FIRMEASY_USER_INTEGRATION_TOKEN=your_integration_token
# FIRMEASY_EMAIL=your_firmeasy_email
# FIRMEASY_PASSWORD=your_firmeasy_password
# FIRMEASY_WEBHOOK_SECRET=your_webhook_secret
FIRMEASY_MODE=sandbox
# Set to "true" ONLY for local dev/CI when FirmEasy credentials are unavailable.
# NEVER set in staging or production — will create fake signatures.
# FIRMEASY_ALLOW_DEV_STUB=true

# --- APIsPERU CPE Issuance (electronic facturas/boletas) ---
# Company token from APIsPERU Facturación v1.3 (non-expiring).
# Do NOT use the 24-hour login token here.
# APISPERU_COMPANY_TOKEN=
APISPERU_BASE_URL=https://facturacion.apisperu.com/api/v1
APISPERU_ENVIRONMENT=beta
# Emitter identity — must match the configured company/RUC record exactly.
# APISPERU_EMITTER_RUC=20616178548
# APISPERU_EMITTER_RAZON_SOCIAL=VERADOC S.A.C.S.
# APISPERU_EMITTER_NOMBRE_COMERCIAL=
# APISPERU_EMITTER_DIRECCION=
# APISPERU_EMITTER_UBIGUEO=
# APISPERU_EMITTER_PROVINCIA=
# APISPERU_EMITTER_DEPARTAMENTO=
# APISPERU_EMITTER_DISTRITO=
# Electronic series — F-family for factura, B-family for boleta.
# APISPERU_FACTURA_SERIES=F001
# APISPERU_BOLETA_SERIES=B001
# APISPERU_CREDIT_NOTE_FACTURA_SERIES=FC01
# APISPERU_CREDIT_NOTE_BOLETA_SERIES=BB01

# --- API PERÚ RUC Lookup (separate product at apiperu.net) ---
# Separate token/subscription from the Facturación service above.
# APIPERU_LOOKUP_TOKEN=
APIPERU_LOOKUP_BASE_URL=https://apiperu.net/api

# --- Notification Outbox (cron-driven email retries) ---
# Secret token to authenticate the outbox processor cron endpoint.
# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET>
# for cron jobs. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Enables durable 60/75/85-day reminders and day-90 soft archival.
# Leave false for report/acceptance validation; enable only after staging review.
COMMERCIAL_ARCHIVAL_MUTATIONS_ENABLED=false
